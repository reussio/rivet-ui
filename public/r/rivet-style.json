{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "rivet-style",
  "title": "Rivet Style",
  "description": "Global Rivet UI scrollbar styles for precise, token-aware application surfaces.",
  "css": {
    "@layer base": {
      "*": {
        "scrollbar-color": "color-mix(in oklab, var(--muted-foreground) 55%, transparent) transparent",
        "scrollbar-width": "thin"
      },
      "*::-webkit-scrollbar": {
        "width": "0.5rem",
        "height": "0.5rem"
      },
      "*::-webkit-scrollbar-track": {
        "background": "transparent"
      },
      "*::-webkit-scrollbar-thumb": {
        "border": "2px solid transparent",
        "background-color": "color-mix(in oklab, var(--muted-foreground) 55%, transparent)",
        "background-clip": "content-box"
      },
      "*::-webkit-scrollbar-thumb:hover": {
        "background-color": "var(--muted-foreground)",
        "background-clip": "content-box"
      }
    }
  },
  "type": "registry:style"
}