{
  "name": "rivet-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "bun run docs:manifest && bun run registry:build",
    "predev": "bun run generate",
    "dev": "next dev",
    "prebuild": "bun run generate",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && bun run audit:matrix",
    "check:write": "biome check --write .",
    "audit:matrix": "bun scripts/validate-component-audit-matrix.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release:check": "bun scripts/release-check.ts",
    "release:tag": "changeset git-tag",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=visual-chromium --project=responsive-chromium",
    "test:visual:update": "playwright test --project=visual-chromium --project=responsive-chromium --update-snapshots",
    "test:responsive": "playwright test --project=responsive-chromium",
    "test:a11y": "playwright test --project=accessibility-chromium",
    "test:functional": "playwright test --project=functional-chromium --project=functional-webkit",
    "docs:manifest": "bun scripts/generate-docs-manifest.ts && biome check --write --vcs-use-ignore-file=false content/components/index.ts content/blocks/index.ts",
    "registry:build": "shadcn build",
    "registry:validate": "bun scripts/validate-registry.mjs",
    "registry:check": "bun run registry:build && bun run registry:validate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.4",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "prism-react-renderer": "^2.4.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
