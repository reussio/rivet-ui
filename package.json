{
  "name": "rivet-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "bun run docs:manifest && bun run registry:build",
    "predev": "bun run generate",
    "dev": "next dev",
    "prebuild": "bun run generate",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "docs:manifest": "bun scripts/generate-docs-manifest.ts && biome check --write --vcs-use-ignore-file=false content/components/index.ts",
    "registry:build": "shadcn build",
    "registry:validate": "bun scripts/validate-registry.mjs",
    "registry:check": "bun run registry:build && bun run registry:validate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.4",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "prism-react-renderer": "^2.4.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14"
}
